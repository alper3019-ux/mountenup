# Standard-Ziel: GitHub Pages (Projektseite unter /mountenup/).
VITE_BASE=/mountenup/
VITE_SITE_URL=https://alper3019-ux.github.io/mountenup/
# Auf GitHub Pages gibt es kein Formular-Backend; die Kontaktadresse ist ein Platzhalter -> "demo".
VITE_FORM_MODE=demo
VITE_CONTACT_EMAIL=hallo@mountenup.example
VITE_HOSTING_PROVIDER="GitHub, Inc. (Dienst „GitHub Pages“)"
VITE_FORM_PRIVACY_NOTE="Hinweis zu dieser Demo-Version: Das Formular sendet und speichert keine Daten – es gibt kein Formular-Backend. Für einen produktiven Einsatz mit Formularversand gilt:"
